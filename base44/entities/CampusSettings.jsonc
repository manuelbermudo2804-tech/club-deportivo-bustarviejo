{
  "name": "CampusSettings",
  "type": "object",
  "properties": {
    "nombre": {
      "type": "string"
    },
    "temporada": {
      "type": "string",
      "description": "Edici\u00f3n anual del Campus, por ejemplo 2027 o 2028."
    },
    "activo": {
      "type": "boolean",
      "default": false
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date"
    },
    "plazas_6_8": {
      "type": "number",
      "default": 12
    },
    "plazas_9_11": {
      "type": "number",
      "default": 14
    },
    "plazas_12_15": {
      "type": "number",
      "default": 14,
      "description": "Campo heredado; no se utiliza para la capacidad actual."
    },
    "plazas_12_16": {
      "type": "number",
      "description": "Capacidad m\u00e1xima configurable del tramo 12\u201316."
    },
    "maximo_total": {
      "type": "number",
      "description": "Capacidad m\u00e1xima general del campamento."
    },
    "ratio_6_8": {
      "type": "number",
      "description": "N\u00famero m\u00e1ximo de participantes por monitor en Iniciaci\u00f3n (6\u20138)."
    },
    "ratio_9_11": {
      "type": "number",
      "description": "N\u00famero m\u00e1ximo de participantes por monitor en Intermedio (9\u201311)."
    },
    "ratio_12_16": {
      "type": "number",
      "description": "N\u00famero m\u00e1ximo de participantes por monitor en Avanzado (12\u201316)."
    },
    "monitor_mode": {
      "type": "string",
      "enum": [
        "calcular",
        "manual"
      ],
      "default": "calcular"
    },
    "monitores_disponibles": {
      "type": "number",
      "description": "N\u00famero de monitores disponibles introducido manualmente."
    },
    "precio_semana_general": {
      "type": "number",
      "default": 60
    },
    "precio_semana_socio": {
      "type": "number",
      "default": 55
    },
    "precio_quincena_general": {
      "type": "number",
      "default": 110
    },
    "precio_quincena_socio": {
      "type": "number",
      "default": 95
    },
    "precio_mes_general": {
      "type": "number",
      "default": 200
    },
    "precio_mes_socio": {
      "type": "number",
      "default": 170
    },
    "cuota_socio": {
      "type": "number",
      "default": 25
    },
    "notas_capacidad": {
      "type": "string"
    },
    "campana_preferente_inicio": {
      "type": "string",
      "format": "date"
    },
    "campana_preferente_fin": {
      "type": "string",
      "format": "date"
    },
    "campana_publica_inicio": {
      "type": "string",
      "format": "date"
    },
    "campana_banner_titulo": {
      "type": "string"
    },
    "campana_banner_texto": {
      "type": "string"
    },
    "campana_preferente_activa": {
      "type": "boolean",
      "default": false,
      "description": "Muestra u oculta el banner de acceso preferente al Campus en la app privada."
    },
    "lista_espera_activa": {
      "type": "boolean",
      "default": false,
      "description": "Permite mostrar y recibir solicitudes de lista de espera del Campus."
    },
    "campana_app_banner_preparado": {
      "type": "boolean",
      "default": false
    },
    "campana_web_preparada": {
      "type": "boolean",
      "default": false
    },
    "campana_notas": {
      "type": "string"
    }
  },
  "required": [
    "nombre"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}