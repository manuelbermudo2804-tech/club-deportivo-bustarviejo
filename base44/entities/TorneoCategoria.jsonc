{
  "name": "TorneoCategoria",
  "type": "object",
  "properties": {
    "torneo_id": {
      "type": "string",
      "description": "ID del Torneo al que pertenece"
    },
    "nombre": {
      "type": "string",
      "description": "Nombre de la categor\u00eda (ej: Alev\u00edn, Benjam\u00edn, Nivel 3)"
    },
    "orden": {
      "type": "number",
      "default": 0,
      "description": "Orden de visualizaci\u00f3n"
    },
    "fase_actual": {
      "type": "string",
      "enum": [
        "liguilla",
        "eliminatorias",
        "finalizada"
      ],
      "default": "liguilla",
      "description": "Fase en la que se encuentra esta categor\u00eda"
    },
    "cuadros_generados": {
      "type": "boolean",
      "default": false,
      "description": "Si ya se generaron los cuadros Oro/Plata desde la liguilla"
    },
    "premios_manuales": {
      "type": "object",
      "description": "Premios que se rellenan a mano (el sistema no los deduce): nombre del portero Zamora de Oro, MVP de Oro y MVP de Plata. El resto de premios del palmar\u00e9s se calculan autom\u00e1ticamente.",
      "properties": {
        "zamora_oro_portero": {
          "type": "string",
          "description": "Nombre del portero del equipo menos goleado de la fase Oro (el equipo lo calcula el sistema)"
        },
        "mvp_oro_nombre": {
          "type": "string",
          "description": "Nombre del MVP (mejor jugador) de la fase Oro"
        },
        "mvp_oro_equipo": {
          "type": "string",
          "description": "Equipo del MVP de la fase Oro"
        },
        "mvp_plata_nombre": {
          "type": "string",
          "description": "Nombre del MVP (mejor jugador) de la fase Plata"
        },
        "mvp_plata_equipo": {
          "type": "string",
          "description": "Equipo del MVP de la fase Plata"
        }
      }
    }
  },
  "required": [
    "torneo_id",
    "nombre"
  ],
  "indexes": [
    {
      "fields": [
        "torneo_id"
      ]
    }
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}