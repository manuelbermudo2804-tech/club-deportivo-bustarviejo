{
  "name": "ReferralTestRun",
  "type": "object",
  "properties": {
    "tipo_registro": {
      "type": "string",
      "enum": [
        "sesion",
        "referido"
      ]
    },
    "session_token": {
      "type": "string"
    },
    "referidor_email": {
      "type": "string"
    },
    "referidor_nombre": {
      "type": "string"
    },
    "flujo": {
      "type": "string",
      "enum": [
        "automatic",
        "manual"
      ]
    },
    "referido_nombre": {
      "type": "string"
    },
    "referido_email": {
      "type": "string"
    },
    "referido_dni": {
      "type": "string"
    },
    "referido_telefono": {
      "type": "string"
    },
    "estado_prueba": {
      "type": "string",
      "enum": [
        "abierta",
        "pendiente_validacion",
        "validado"
      ]
    },
    "pago_simulado": {
      "type": "boolean",
      "default": false
    },
    "numero_papeleta": {
      "type": "string"
    },
    "fecha_prueba": {
      "type": "string",
      "format": "date-time"
    },
    "fecha_validacion": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "tipo_registro",
    "session_token"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}