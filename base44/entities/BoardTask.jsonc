{
  "name": "BoardTask",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "Título de la tarea"
    },
    "descripcion": {
      "type": "string",
      "description": "Descripción detallada"
    },
    "area": {
      "type": "string",
      "enum": [
        "Presidencia",
        "Vicepresidencia",
        "Secretaría",
        "Tesorería",
        "Material e instalaciones",
        "Cantera y equipos base",
        "Eventos y patrocinio"
      ],
      "description": "Área responsable"
    },
    "prioridad": {
      "type": "string",
      "enum": [
        "baja",
        "media",
        "alta"
      ],
      "default": "media",
      "description": "Prioridad de la tarea"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "en_progreso",
        "bloqueado",
        "hecho"
      ],
      "default": "pendiente",
      "description": "Estado Kanban"
    },
    "fecha_limite": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite (opcional)"
    },
    "rol_asignado": {
      "type": "string",
      "enum": [
        "Presidente",
        "Vicepresidente",
        "Secretaría",
        "Tesorero",
        "Vocal1",
        "Vocal2",
        "Vocal3"
      ],
      "description": "Rol asignado"
    },
    "asignado_a_email": {
      "type": "string",
      "format": "email",
      "description": "Asignación directa a una persona (opcional)"
    },
    "comentarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "autor_email": {
            "type": "string"
          },
          "autor_nombre": {
            "type": "string"
          },
          "mensaje": {
            "type": "string"
          },
          "fecha": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "Historial de comentarios"
    },
    "incidencia_id": {
      "type": "string",
      "description": "Vincular a incidencia (opcional)"
    },
    "fecha_cierre": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en la que se marcó como hecho"
    },
    "cerrado_por_email": {
      "type": "string",
      "description": "Email de quien cerró la tarea"
    },
    "cerrado_por_nombre": {
      "type": "string",
      "description": "Nombre de quien cerró la tarea"
    }
  },
  "required": [
    "titulo",
    "estado"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "es_junta": true
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "es_junta": true
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "es_junta": true
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "es_junta": true
          }
        }
      ]
    }
  }
}
