{
  "name": "SurveyParticipation",
  "type": "object",
  "properties": {
    "survey_id": {
      "type": "string",
      "description": "Identificador de la encuesta"
    },
    "participant_hash": {
      "type": "string",
      "description": "Huella seud\u00f3nima para evitar respuestas repetidas; nunca se guarda en la respuesta"
    }
  },
  "required": [
    "survey_id",
    "participant_hash"
  ],
  "indexes": [
    {
      "fields": [
        "survey_id",
        "participant_hash"
      ]
    }
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "service_role"
      }
    },
    "read": {
      "user_condition": {
        "role": "service_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "service_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "service_role"
      }
    }
  }
}