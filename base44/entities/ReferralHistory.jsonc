{
  "name": "ReferralHistory",
  "type": "object",
  "properties": {
    "temporada": {
      "type": "string",
      "description": "Temporada del referido (ej: 2024/2025)"
    },
    "referidor_email": {
      "type": "string",
      "description": "Email de quien refirió"
    },
    "referidor_nombre": {
      "type": "string",
      "description": "Nombre de quien refirió"
    },
    "referido_email": {
      "type": "string",
      "description": "Email del socio referido"
    },
    "referido_nombre": {
      "type": "string",
      "description": "Nombre del socio referido"
    },
    "referido_id": {
      "type": "string",
      "description": "ID del socio en ClubMember"
    },
    "estado": {
      "type": "string",
      "enum": [
        "activo",
        "renovado",
        "baja"
      ],
      "default": "activo",
      "description": "Estado actual del socio referido"
    },
    "credito_otorgado": {
      "type": "number",
      "description": "Crédito en ropa otorgado al referidor"
    },
    "sorteos_otorgados": {
      "type": "number",
      "description": "Participaciones en sorteo otorgadas"
    },
    "numero_papeleta": {
      "type": "string",
      "description": "Número de papeleta aleatorio y único asignado a este referido para el sorteo (ej: 0427)"
    },
    "fecha_referido": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se refirió"
    }
  },
  "required": [
    "temporada",
    "referidor_email",
    "referidor_nombre",
    "referido_nombre"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referidor_email": "{{user.email}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
