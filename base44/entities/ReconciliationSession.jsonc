{
  "name": "ReconciliationSession",
  "type": "object",
  "properties": {
    "extracto_url": {
      "type": "string",
      "description": "URL del extracto bancario subido (CSV)"
    },
    "movimientos_totales": {
      "type": "number",
      "description": "Total de movimientos importados"
    },
    "movimientos_reconciliados": {
      "type": "number",
      "default": 0,
      "description": "Movimientos ya reconciliados"
    },
    "movimientos_pendientes": {
      "type": "number",
      "description": "Movimientos pendientes de revisar"
    },
    "admin_email": {
      "type": "string",
      "description": "Email del admin que realiz\u00f3 la sesi\u00f3n"
    },
    "completada": {
      "type": "boolean",
      "default": false,
      "description": "Si la sesi\u00f3n est\u00e1 completada"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio del periodo"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin del periodo"
    },
    "cuenta_bancaria": {
      "type": "string",
      "description": "Identificador de la cuenta asociada a esta importaci\u00f3n"
    },
    "archivo_nombre": {
      "type": "string",
      "description": "Nombre del archivo de extracto importado"
    },
    "movimientos_duplicados": {
      "type": "number",
      "default": 0,
      "description": "Movimientos detectados y omitidos por duplicidad"
    },
    "saldo_inicial_extracto": {
      "type": "number",
      "description": "Saldo inicial declarado en el extracto"
    },
    "saldo_final_extracto": {
      "type": "number",
      "description": "Saldo final declarado en el extracto"
    },
    "saldo_calculado_extracto": {
      "type": "number",
      "description": "Saldo inicial m\u00e1s el neto de los movimientos del per\u00edodo"
    },
    "diferencia_saldos": {
      "type": "number",
      "description": "Diferencia entre saldo final declarado y saldo calculado"
    },
    "importe_neto_importado": {
      "type": "number",
      "description": "Neto de los movimientos nuevos incorporados"
    }
  },
  "required": [
    "extracto_url",
    "movimientos_totales",
    "admin_email",
    "fecha_inicio",
    "fecha_fin"
  ]
}