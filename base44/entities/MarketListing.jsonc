{
  "name": "MarketListing",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descripcion": {
      "type": "string"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "F\u00fatbol",
        "Baloncesto",
        "Equipaci\u00f3n",
        "Calzado",
        "Protecciones",
        "Accesorios",
        "Otro Deportivo"
      ]
    },
    "tipo": {
      "type": "string",
      "enum": [
        "venta",
        "donacion"
      ],
      "default": "venta"
    },
    "precio": {
      "type": "number",
      "default": 0
    },
    "imagenes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Fotos del art\u00edculo. Obligatorio al menos una para publicar."
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "activo",
        "reservado",
        "vendido",
        "entregado",
        "cancelado"
      ],
      "default": "activo",
      "description": "pendiente = a revisar por el club; activo = publicado; reservado; vendido; entregado (donaciones); cancelado = retirado"
    },
    "vendedor_nombre": {
      "type": "string"
    },
    "vendedor_email": {
      "type": "string"
    },
    "vendedor_telefono": {
      "type": "string"
    },
    "reservado_por_email": {
      "type": "string"
    },
    "reservado_por_nombre": {
      "type": "string"
    },
    "reservado_por_telefono": {
      "type": "string",
      "description": "Tel\u00e9fono de contacto de quien reserva"
    },
    "reservado_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "reserva_temporal_hasta": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha y hora de caducidad de la reserva temporal"
    },
    "ultimo_recordatorio_reserva": {
      "type": "string",
      "format": "date-time",
      "description": "\u00daltimo email/notificaci\u00f3n de recordatorio enviado al vendedor"
    },
    "vendido_fecha": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que el vendedor puls\u00f3 VENDIDO / ENTREGADO. Se usa para mantenerlo visible unos d\u00edas con el cartel VENDIDO."
    },
    "comprador_final_nombre": {
      "type": "string",
      "description": "Persona a la que finalmente se vendi\u00f3/entreg\u00f3 el art\u00edculo"
    },
    "comprador_final_email": {
      "type": "string"
    },
    "notas_admin": {
      "type": "string",
      "description": "Notas internas del club sobre este anuncio"
    },
    "cancelado_por": {
      "type": "string",
      "description": "Email de quien retir\u00f3 o cancel\u00f3 el anuncio"
    },
    "motivo_cancelacion": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "tipo",
    "vendedor_email",
    "vendedor_telefono"
  ]
}