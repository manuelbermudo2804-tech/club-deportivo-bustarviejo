{
  "name": "SeasonConfig",
  "type": "object",
  "properties": {
    "temporada": {
      "type": "string",
      "description": "Temporada (ej: 2024-2025)"
    },
    "activa": {
      "type": "boolean",
      "default": false,
      "description": "Si es la temporada activa"
    },
    "cuota_unica": {
      "type": "number",
      "description": "Importe de cuota única en euros"
    },
    "cuota_tres_meses": {
      "type": "number",
      "description": "Importe de cuota fraccionada (cada pago) en euros"
    },
    "permitir_plan_mensual": {
      "type": "boolean",
      "default": false,
      "description": "Permitir plan mensual con domiciliación por tarjeta (60% inicial + resto prorrateado)"
    },
    "plan_mensual_porcentaje_inicial": {
      "type": "number",
      "default": 60,
      "description": "Porcentaje del total que se paga inicialmente en Junio (ej: 60)"
    },
    "plan_mensual_mes_fin": {
      "type": "string",
      "enum": [
        "Enero",
        "Febrero",
        "Marzo",
        "Abril",
        "Mayo",
        "Junio"
      ],
      "default": "Mayo",
      "description": "Último mes en que se cobra la mensualidad"
    },
    "plan_mensual_modo_test": {
      "type": "boolean",
      "default": false,
      "description": "Si está activado, el Plan Mensual solo estará visible para los emails de la lista de test"
    },
    "plan_mensual_emails_test": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Lista de emails que pueden ver el Plan Mensual en modo test"
    },
    "fecha_inicio": {
      "type": "string",
      "format": "date",
      "description": "Fecha de inicio de temporada"
    },
    "fecha_fin": {
      "type": "string",
      "format": "date",
      "description": "Fecha de fin de temporada"
    },
    "google_sheets_id": {
      "type": "string",
      "description": "ID del Google Sheets para sincronización de presupuestos"
    },
    "permitir_renovaciones": {
      "type": "boolean",
      "default": false,
      "description": "Si se permite renovar jugadores de temporadas anteriores"
    },
    "fecha_limite_renovaciones": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para renovar jugadores (opcional)"
    },
    "enviar_recordatorios_renovacion": {
      "type": "boolean",
      "default": false,
      "description": "Enviar recordatorios automáticos de renovación"
    },
    "dias_antes_recordatorio_renovacion": {
      "type": "number",
      "default": 15,
      "description": "Días antes de la fecha límite para enviar recordatorio automático"
    },
    "tienda_ropa_abierta": {
      "type": "boolean",
      "default": false,
      "description": "Control manual para abrir/cerrar la tienda de ropa"
    },
    "productos_ropa": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nombre": {
            "type": "string"
          },
          "precio": {
            "type": "number"
          },
          "activo": {
            "type": "boolean"
          },
          "orden": {
            "type": "number"
          }
        }
      },
      "description": "Catálogo de productos de ropa con precios configurables"
    },
    "loteria_navidad_abierta": {
      "type": "boolean",
      "default": false,
      "description": "Control manual para abrir/cerrar pedidos de lotería"
    },
    "loteria_requiere_pago_adelantado": {
      "type": "boolean",
      "default": false,
      "description": "Si la lotería requiere pago adelantado con justificante"
    },
    "precio_decimo_loteria": {
      "type": "number",
      "default": 22,
      "description": "Precio del décimo de lotería en euros"
    },
    "loteria_max_decimos": {
      "type": "number",
      "description": "Número máximo de décimos disponibles para vender"
    },
    "bizum_activo": {
      "type": "boolean",
      "default": false,
      "description": "Permitir pagos con Bizum"
    },
    "bizum_telefono": {
      "type": "string",
      "description": "Número de teléfono del club para Bizum"
    },
    "club_iban": {
      "type": "string",
      "description": "IBAN del club para transferencias bancarias (sin espacios). Si está vacío, se usa el IBAN por defecto."
    },
    "club_bank": {
      "type": "string",
      "description": "Nombre del banco del club (ej: Banco Santander). Si está vacío, se usa el banco por defecto."
    },
    "mostrar_patrocinadores": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar banner de patrocinadores en la app"
    },
    "notificaciones_admin_email": {
      "type": "boolean",
      "default": false,
      "description": "Enviar correos automáticos al administrador"
    },
    "notificaciones_push_manuales_activas": {
      "type": "boolean",
      "default": true,
      "description": "Activar/desactivar SOLO las notificaciones push manuales"
    },
    "programa_referidos_activo": {
      "type": "boolean",
      "default": false,
      "description": "Activar programa de incentivos por referir nuevos socios"
    },
    "referidos_permitir_whatsapp_padres": {
      "type": "boolean",
      "default": true,
      "description": "Permitir a los padres compartir su enlace de referidos por WhatsApp"
    },
    "sorteo_premio_principal_nombre": {
      "type": "string",
      "description": "Nombre del premio principal del sorteo de referidos (ej: PlayStation 5)"
    },
    "sorteo_premio_principal_foto": {
      "type": "string",
      "description": "URL de la foto principal del premio del sorteo de referidos"
    },
    "sorteo_premio_fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Hasta tres fotografías adicionales para la galería del premio principal"
    },
    "sorteo_premio_principal_texto": {
      "type": "string",
      "description": "Texto descriptivo del premio principal (condiciones, fecha del sorteo, etc.)"
    },
    "sorteo_premio_valor": {
      "type": "number",
      "default": 0,
      "description": "Valor estimado del premio principal en euros. Sirve para calcular cuántas papeletas se necesitan antes de poder sortear (rentabilidad)."
    },
    "sorteo_valor_papeleta": {
      "type": "number",
      "default": 25,
      "description": "Valor en euros que aporta cada papeleta/amigo referido (normalmente la cuota de socio). Con el valor del premio se calcula el umbral mínimo de papeletas para que el sorteo sea rentable."
    },
    "sorteo_fecha": {
      "type": "string",
      "description": "Fecha y hora del sorteo del premio principal (formato YYYY-MM-DDTHH:mm, hora local). Se muestra como cuenta atrás a los socios."
    },
    "sorteo_lugar": {
      "type": "string",
      "description": "Dónde se celebra el sorteo (ej: Torneo de fin de temporada)"
    },
    "sorteo_premios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "descripcion": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "description": "Lista de premios disponibles en los sorteos"
    },
    "programa_socios_activo": {
      "type": "boolean",
      "default": false,
      "description": "Activar sistema de carnets digitales de socio con descuentos"
    },
    "carnet_publico_activo": {
      "type": "boolean",
      "default": false,
      "description": "Activar enlace público del carnet de socio (para socios externos sin app)"
    },
    "precio_socio": {
      "type": "number",
      "default": 25,
      "description": "Precio anual de la cuota de socio en euros"
    },
    "dias_gracia_carnet": {
      "type": "number",
      "default": 15,
      "description": "Días de gracia después de cada fecha límite de pago"
    },
    "comercios_descuento": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "descuento": {
            "type": "string"
          },
          "direccion": {
            "type": "string"
          },
          "telefono": {
            "type": "string"
          },
          "categoria": {
            "type": "string",
            "enum": [
              "Restaurantes",
              "Tiendas",
              "Servicios",
              "Ocio",
              "Salud",
              "Otro"
            ]
          },
          "codigo_descuento": {
            "type": "string",
            "description": "Código de descuento que el socio debe usar (ej: para tiendas online)"
          },
          "instrucciones_codigo": {
            "type": "string",
            "description": "Instrucciones para usar el código (ej: Introduce este código en el checkout)"
          }
        }
      },
      "description": "Lista de comercios que ofrecen descuentos a socios del club"
    },
    "notas": {
      "type": "string",
      "description": "Notas sobre la temporada"
    },
    "tienda_ropa_url": {
      "type": "string",
      "description": "URL externa de la tienda de equipación"
    },
    "tienda_merch_url": {
      "type": "string",
      "description": "URL externa de la tienda de merchandising del club"
    },
    "bloqueo_convocatorias_impago": {
      "type": "boolean",
      "default": false,
      "description": "Si está activo, los jugadores con pagos vencidos aparecen marcados y excluidos por defecto en las convocatorias"
    },
    "dias_gracia_convocatoria": {
      "type": "number",
      "default": 14,
      "description": "Días de gracia después del vencimiento del pago antes de marcar al jugador como moroso en convocatorias"
    },
    "fecha_limite_patrocinios": {
      "type": "string",
      "format": "date",
      "description": "Fecha límite para presentar solicitudes de patrocinio (se muestra en la web pública)"
    },
    "campana_torneos_activa": {
      "type": "boolean",
      "default": false,
      "description": "Mostrar la campaña de Patrocinio de Torneos (Pádel + Fútbol Sala) en la página pública /Patrocinadores"
    },
    "torneo_padel_fecha": {
      "type": "string",
      "description": "Texto libre con la fecha del torneo de pádel (ej: 'Sábado 20 Junio 2026' o 'Junio 2026 · fecha por confirmar')"
    },
    "torneo_futsal_fecha": {
      "type": "string",
      "description": "Texto libre con la fecha del torneo de fútbol sala"
    },
    "torneo_padel_ocupado": {
      "type": "boolean",
      "default": false,
      "description": "Marcar como YA RESERVADO el patrocinio del torneo de pádel"
    },
    "torneo_futsal_ocupado": {
      "type": "boolean",
      "default": false,
      "description": "Marcar como YA RESERVADO el patrocinio del torneo de fútbol sala"
    },
    "fondo_solidario_activo": {
      "type": "boolean",
      "default": false,
      "description": "Activar el Fondo Solidario de Becas: las familias pueden aportar voluntariamente para becar a niños sin recursos"
    },
    "fondo_solidario_importes": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "default": [
        10,
        20,
        50
      ],
      "description": "Los 3 importes (€) que la familia puede elegir para su aportación solidaria"
    },
    "fondo_solidario_texto": {
      "type": "string",
      "default": "Aporta voluntariamente para becar a niños y niñas del club que lo necesiten. El 100% del dinero recaudado se destinará a cubrir cuotas de familias sin recursos.",
      "description": "Texto que verán las familias al activar la aportación solidaria"
    },
    "fondo_solidario_titulo": {
      "type": "string",
      "default": "💚 Fondo Solidario de Becas",
      "description": "Título mostrado a las familias en la opción de aportación"
    },
    "pago_adelantado_emails_prueba": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Cuentas de PRUEBA del pago por adelantado (correos). En las categorias en modo Prueba, solo estas cuentas ven el pago por adelantado y pueden saltarse Stripe. Las demas familias ven el formulario de siempre."
    }
  },
  "required": [
    "temporada",
    "cuota_unica",
    "cuota_tres_meses"
  ]
}
