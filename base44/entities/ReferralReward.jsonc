{
  "name": "ReferralReward",
  "type": "object",
  "properties": {
    "referrer_email": {
      "type": "string",
      "description": "Email del socio que refirió"
    },
    "referrer_name": {
      "type": "string",
      "description": "Nombre del socio que refirió"
    },
    "referred_member_id": {
      "type": "string",
      "description": "ID del nuevo socio referido"
    },
    "referred_member_name": {
      "type": "string",
      "description": "Nombre del nuevo socio referido"
    },
    "referred_player_id": {
      "type": "string",
      "description": "ID del jugador referido (si aplica)"
    },
    "referred_player_name": {
      "type": "string",
      "description": "Nombre del jugador referido"
    },
    "referred_player_category": {
      "type": "string",
      "description": "Categoría del jugador referido (ej: Fútbol Femenino)"
    },
    "temporada": {
      "type": "string",
      "description": "Temporada en la que se realizó la referencia"
    },
    "clothing_credit_earned": {
      "type": "number",
      "default": 0,
      "description": "Crédito en ropa ganado por esta referencia"
    },
    "raffle_entries_earned": {
      "type": "number",
      "default": 0,
      "description": "Participaciones en sorteo ganadas por esta referencia"
    },
    "special_reward": {
      "type": "string",
      "description": "Premio especial ganado (ej: Noche de Hotel)"
    },
    "reward_tier": {
      "type": "string",
      "enum": [
        "tier_1",
        "tier_3",
        "tier_5",
        "tier_10",
        "tier_15"
      ],
      "description": "Nivel de premio alcanzado"
    },
    "reward_claimed": {
      "type": "boolean",
      "default": false,
      "description": "Si el premio ha sido reclamado/entregado"
    },
    "claimed_date": {
      "type": "string",
      "format": "date-time",
      "description": "Fecha en que se reclamó el premio"
    },
    "notas": {
      "type": "string",
      "description": "Notas adicionales"
    }
  },
  "required": [
    "referrer_email",
    "referrer_name",
    "referred_member_id",
    "referred_member_name",
    "temporada"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.referrer_email": "{{user.email}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
