{
  "name": "ContratoVoluntariado",
  "type": "object",
  "description": "Acuerdo de voluntariado personalizado que se firma con el dedo en la app (menores: firma del menor + tutor)",
  "properties": {
    "entrenador_email": {
      "type": "string",
      "description": "Email con el que entra en la app quien firma"
    },
    "entrenador_nombre": {
      "type": "string"
    },
    "es_menor": {
      "type": "boolean",
      "default": false,
      "description": "Si es menor, tambi\u00e9n firma su padre/madre/tutor"
    },
    "titulo": {
      "type": "string",
      "default": "Acuerdo de incorporaci\u00f3n como voluntario"
    },
    "texto": {
      "type": "string",
      "description": "Texto completo del acuerdo"
    },
    "texto_hash": {
      "type": "string",
      "description": "Huella SHA-256 del texto al crearlo"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "firmado"
      ],
      "default": "pendiente"
    },
    "firma_uri": {
      "type": "string",
      "description": "Imagen privada de la firma"
    },
    "firma_fecha": {
      "type": "string",
      "format": "date-time"
    },
    "firma_dni": {
      "type": "string"
    },
    "firma_nombre": {
      "type": "string"
    },
    "firma_user_agent": {
      "type": "string"
    },
    "acepta_privacidad": {
      "type": "boolean",
      "default": false
    },
    "tutor_nombre": {
      "type": "string"
    },
    "tutor_dni": {
      "type": "string"
    },
    "tutor_relacion": {
      "type": "string"
    },
    "tutor_firma_uri": {
      "type": "string"
    }
  },
  "required": [
    "entrenador_email",
    "texto"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.entrenador_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.entrenador_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}