{
  "name": "CampusRegistration",
  "type": "object",
  "properties": {
    "adulto_nombre": {
      "type": "string"
    },
    "adulto_dni": {
      "type": "string"
    },
    "adulto_email": {
      "type": "string",
      "format": "email"
    },
    "adulto_telefono": {
      "type": "string"
    },
    "adulto_municipio": {
      "type": "string"
    },
    "es_socio": {
      "type": "boolean",
      "default": false
    },
    "socio_verificado": {
      "type": "boolean",
      "default": false
    },
    "club_member_id": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "confirmada",
        "cancelada",
        "revision"
      ],
      "default": "pendiente"
    },
    "estado_pago": {
      "type": "string",
      "enum": [
        "pendiente",
        "pagado",
        "fallido",
        "no_requerido"
      ],
      "default": "pendiente"
    },
    "importe_total": {
      "type": "number",
      "default": 0
    },
    "cuota_socio_incluida": {
      "type": "number",
      "default": 0
    },
    "stripe_session_id": {
      "type": "string"
    },
    "stripe_payment_intent": {
      "type": "string"
    },
    "consentimiento_datos": {
      "type": "boolean",
      "default": false
    },
    "consentimiento_imagen": {
      "type": "boolean",
      "default": false
    },
    "notas": {
      "type": "string"
    },
    "adulto_direccion": {
      "type": "string"
    },
    "adulto_fecha_nacimiento": {
      "type": "string",
      "format": "date"
    },
    "adulto_tipo_inscripcion": {
      "type": "string",
      "enum": [
        "Nueva Inscripci\u00f3n",
        "Renovaci\u00f3n"
      ],
      "default": "Nueva Inscripci\u00f3n"
    },
    "adulto_referido_por": {
      "type": "string"
    },
    "segundo_progenitor_nombre": {
      "type": "string"
    },
    "segundo_progenitor_email": {
      "type": "string",
      "format": "email"
    },
    "segundo_progenitor_telefono": {
      "type": "string"
    },
    "es_segundo_progenitor": {
      "type": "boolean",
      "default": false
    },
    "semanas_solicitadas": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "S1",
          "S2",
          "S3",
          "S4",
          "S5"
        ]
      }
    },
    "participantes_count": {
      "type": "integer",
      "minimum": 1
    },
    "estado_alta_socio": {
      "type": "string",
      "enum": [
        "no_requerida",
        "pendiente",
        "pagado",
        "fallido"
      ],
      "default": "no_requerida"
    }
  },
  "required": [
    "adulto_nombre",
    "adulto_email",
    "adulto_telefono",
    "estado"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}