{
  "name": "Push: Nueva oportunidad de voluntariado",
  "description": "Env\u00eda push y correo a todas las familias cuando se crea una oportunidad de voluntariado",
  "trigger": {
    "condition": "${ (.trigger.data.estado // \"abierta\") != \"cerrada\" }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "VolunteerOpportunity"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_nueva_oportunidad_voluntariado",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPushTrigger",
            "args": {
              "event": {
                "entity_name": "VolunteerOpportunity",
                "entity_id": "${ .trigger.entity_id }",
                "type": "create"
              },
              "data": "${ .trigger.data }"
            }
          },
          "then": "send_emails",
          "x-base44": {
            "title": "Enviar push a familias"
          }
        }
      },
      {
        "send_emails": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyVolunteerOpportunity",
            "args": {
              "opportunity_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar correo a familias"
          }
        }
      }
    ]
  }
}