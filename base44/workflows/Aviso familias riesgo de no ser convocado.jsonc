  "description": "Cada d\u00eda a las 10:00 avisa (email + push) a las familias con una cuota vencida que a\u00fan est\u00e1 dentro de los d\u00edas de gracia, antes de que el jugador deje de entrar en las convocatorias. Solo act\u00faa si el bloqueo por impago est\u00e1 activado.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "aviso_riesgo_convocatoria",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_avisos": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "avisoRiesgoConvocatoria",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Avisar familias con cuota vencida",
            "description": "Email + push, una vez por cuota"
          }
        }
      }
    ]
  }
