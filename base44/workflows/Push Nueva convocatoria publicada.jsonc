{
  "name": "Push Nueva convocatoria publicada",
  "description": "Avisa a las familias de los convocados cuando se crea publicada o se publica un borrador.",
  "trigger": {
    "condition": "${ (.trigger.data.publicada == true) and ((.trigger.event_type == \"create\") or ((.trigger.event_type == \"update\") and (.trigger.old_data.publicada != true))) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Convocatoria"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "push_nueva_convocatoria_publicada",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "enviar_push": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "onPushTrigger",
            "args": {
              "event": {
                "entity_name": "Convocatoria",
                "entity_id": "${ .trigger.entity_id }",
                "type": "${ .trigger.event_type }"
              },
              "data": "${ .trigger.data }",
              "old_data": "${ .trigger.old_data }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Enviar push a convocados"
          }
        }
      }
    ]
  }
}