{
  "name": "RFFM Bajas m\u00e9dicas (diario 7:00)",
  "description": "Cada d\u00eda a las 7:00 lee de la Federaci\u00f3n los jugadores en baja m\u00e9dica; los lunes tambi\u00e9n las fechas de reconocimiento m\u00e9dico",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "rffm_bajas_medicas_diario",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "sync_bajas": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rffmSyncBajasMedicas",
            "args": {}
          },
          "then": "sync_reconocimientos",
          "x-base44": {
            "title": "Sincronizar bajas m\u00e9dicas",
            "description": "Lee la intranet de la Federaci\u00f3n"
          }
        }
      },
      {
        "sync_reconocimientos": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "rffmSyncReconocimientos",
            "args": {
              "solo_lunes": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Sincronizar reconocimientos m\u00e9dicos (solo lunes)",
            "description": "Guarda la fecha de caducidad del reconocimiento de cada jugador"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 7 * * *",
      "one_time_date": null,
      "timezone": "Europe/Madrid",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}